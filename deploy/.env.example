# Copy to /srv/docker/compose/dgsis-website/.env on the VPS (never commit real secrets).
# Alongside: docker-compose.yml (see deploy/README.md). CD runs deploy-blue-green.sh
# from the git checkout and points ENV_FILE/COMPOSE_FILE here.
# IMAGE_TAG is overridden by CD to the git tag (vX.Y.Z) on each deploy.
#
# Single production stack on the shared Traefik VPS. There is no separate staging
# hostname yet — "deploy" means this prod stack.
#
# This site has no database and no GitHub Actions secrets. The only host file is
# this .env. Do not reuse /srv/docker/compose/academy/.env.

# Image — local Docker name on the VPS (CD builds here; no GHCR push/pull).
# The ghcr.io/... string is only a conventional tag name, not a registry pull.
WEBSITE_IMAGE=ghcr.io/dgsis-tech/dgsis-website
IMAGE_TAG=v0.1.0

# Buildx cache lives on the runner as $HOME/.cache/dgsis-website-buildx (not /var/cache
# and not academy's $HOME/.cache/academy-buildx). See scripts/cd-prune-host.sh.

# Traefik (public edge — GLOBAL on the VPS; not started by this Compose file).
# On the shared dgsis VPS the external Docker network is named "frontend".
TRAEFIK_NETWORK=frontend
# Confirm the public hostname with the operator before the first tag.
WEBSITE_HOST=dgsis.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Set by deploy-blue-green.sh; leave false in .env
BLUE_TRAEFIK_ENABLE=false
GREEN_TRAEFIK_ENABLE=false

# App listen port inside the container (cmd/web reads PORT).
PORT=8080
